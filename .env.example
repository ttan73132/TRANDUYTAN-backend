NODE_ENV=production
PORT=8080
TRUST_PROXY=true
APP_TIME_ZONE=Asia/Bangkok
DATABASE_URL=
DATABASE_SSL=true
# Optional PEM CA certificate if the database provider requires a custom CA.
DATABASE_CA_CERT=
# Generate two different random values of at least 32 characters. Never put these in Flutter.
JWT_SECRET=
OTP_SECRET=
# Default: existing Gmail via the reviewed Google Apps Script relay.
EMAIL_PROVIDER=apps_script
OTP_RELAY_URL=
# A third random secret; same value in Apps Script Script properties, never in source.
OTP_RELAY_SECRET=
# Optional only when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
# Use a sender registered/verified in Brevo; domain authentication may be required.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Chấm công Nguyễn Hoài Nam
# Optional FCM HTTP v1. Leave BOTH blank to disable push explicitly.
# Backend secret only: never put the service-account JSON in Flutter or Git.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Only for initial bootstrap. Remove all four variables after the first successful deploy.
BOOTSTRAP_ADMIN_FULL_NAME=Nguyễn Hoài Nam
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
